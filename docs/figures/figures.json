  {
    "name": "03-selection",
    "title": "Lexical scoring and constrained assembly",
    "caption": "The equation restates _score; it is not a learned objective or an optimality claim. Each topic independently selects the highest-scoring cue when score >= 0.35. Chronological context fills duration, nearby intervals merge, and an optional first-topic instruction reorders a whole clip. Negation and visual meaning are outside this scoring model.",
    "source": "clipagent/planning.py::_tokens, _score, build_timeline",
    "width": 1120,
    "height": 500,
    "items": [
      {
        "kind": "text",
        "text": "Q = topic tokens; C = cue tokens; N = number of transcript cues",
        "x": 30,
        "y": 35,
        "size": 25,
        "color": "#152C46"
      },
      {
        "kind": "text",
        "text": "w(t) = log(1 + (N + 1) / (df(t) + 1))",
        "x": 30,
        "y": 95,
        "size": 30,
        "color": "#245FA5"
      },
      {
        "kind": "text",
        "text": "score(Q,C) = sum[ w(t), t in Q intersect C ] / sum[ w(t), t in Q ]",
        "x": 30,
        "y": 155,
        "size": 26,
        "color": "#245FA5"
      },
      {
        "kind": "text",
        "text": "                     + 0.5 * I[ exact topic phrase occurs in cue ]",
        "x": 30,
        "y": 200,
        "size": 26,
        "color": "#245FA5"
      },
      {
        "kind": "text",
        "text": "df(t): cue count containing t; I: indicator; empty Q returns score 0",
        "x": 30,
        "y": 244,
        "size": 21,
        "color": "#516477"
      },
      {
        "kind": "rect",
        "x": 30,
        "y": 280,
        "w": 320,
        "h": 95,
        "fill": "#EDF3F9",
        "stroke": "#245FA5"
      },
      {
        "kind": "text",
        "text": "Rank cues",
        "x": 44,
        "y": 304,
        "size": 24,
        "color": "#152C46"
      },
      {
        "kind": "text",
        "text": "Per topic; threshold 0.35",
        "x": 44,
        "y": 332,
        "size": 20,
        "color": "#516477"
      },
      {
        "kind": "arrow",
        "x1": 350,
        "y1": 326,
        "x2": 395,
        "y2": 326,
        "color": "#245FA5"
      },
      {
        "kind": "rect",
        "x": 395,
        "y": 280,
        "w": 320,
        "h": 95,
        "fill": "#EDF3F9",
        "stroke": "#245FA5"
      },
      {
        "kind": "text",
        "text": "Build intervals",
        "x": 409,
        "y": 304,
        "size": 24,
        "color": "#152C46"
      },
      {
        "kind": "text",
        "text": "-0.18s / +0.22s padding",
        "x": 409,
        "y": 332,
        "size": 20,
        "color": "#516477"
      },
      {
        "kind": "arrow",
        "x1": 715,
        "y1": 326,
        "x2": 760,
        "y2": 326,
        "color": "#245FA5"
      },
      {
        "kind": "rect",
        "x": 760,
        "y": 280,
        "w": 320,
        "h": 95,
        "fill": "#EDF3F9",
        "stroke": "#245FA5"
      },
      {
        "kind": "text",
        "text": "Assemble edit",
        "x": 774,
        "y": 304,
        "size": 24,
        "color": "#152C46"
      },
      {
        "kind": "text",
        "text": "Context / merge / order",
        "x": 774,
        "y": 332,
        "size": 20,
        "color": "#516477"
      },
      {
        "kind": "text",
        "text": "Constraints: 0 <= start < end <= source duration; no same-source overlap",
        "x": 30,
        "y": 430,
        "size": 24,
        "color": "#152C46"
      },
      {
        "kind": "text",
        "text": "Greedy heuristic; no global optimum and no semantic-entailment guarantee",
        "x": 30,
        "y": 480,
        "size": 23,
        "color": "#A53F35"
      }
    ]
